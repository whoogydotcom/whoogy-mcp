# Port this MCP server listens on locally.
MCP_PORT=5000

# The externally-reachable base URL of THIS server (ngrok locally,
# https://mcp.whoogy.com in production). Every OAuth metadata URL is derived
# from it — it must be HTTPS whenever a remote client (claude.ai) is involved.
MCP_PUBLIC_URL=http://localhost:5000

# Number of reverse-proxy hops in front of this server (ngrok locally,
# nginx/Cloudflare in production). Passed straight to Express's "trust proxy".
MCP_TRUST_PROXY=1

# Base URL of the main Whoogy REST API this server calls on the user's
# behalf (see src/api-client.ts).
MCP_API_BASE=http://localhost:4000

# Base URL of the Whoogy web app — the OAuth consent screen
# (/connect/claude) lives here.
FRONTEND_URL=http://localhost:3000

# Shared MongoDB used for OAuth client/grant storage and the plugin-auth
# device-code handshake — must point at the SAME database as the main
# Whoogy API, since both services read/write these collections.
MONGODB_URI=
DB_NAME=

# Must match the JWT_SECRET used by the main Whoogy API — the MCP access
# token IS the same Whoogy-issued JWT, verified here with this secret.
JWT_SECRET=
